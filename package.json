{
  "name": "amanah-sosial-dakwah-terintegrasi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "deadcode": "knip",
    "quality": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node scripts/neon/migrate.mjs",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "neon:migrate": "node scripts/neon/migrate.mjs",
    "neon:reset": "node scripts/neon/reset-database.mjs",
    "neon:seed": "node scripts/neon/seed-development.mjs",
    "neon:provision:roles": "node scripts/neon/provision-role-accounts.mjs",
    "neon:types": "node scripts/neon/generate-types.mjs",
    "neon:test:isolation": "node scripts/neon/test-tenant-isolation.mjs",
    "neon:test:fund-concurrency": "node scripts/neon/test-fund-concurrency.mjs",
    "neon:test:kafalah-concurrency": "node scripts/neon/test-kafalah-concurrency.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@hookform/resolvers": "5.5.7",
    "@neondatabase/serverless": "^1.1.0",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "lucide-react": "1.27.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-router": "8.3.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.24",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "react-router": "8.3.0"
  }
}
